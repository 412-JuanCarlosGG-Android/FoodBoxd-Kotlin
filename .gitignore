# ---------------------------------------------------------------------
# Android / Kotlin / Gradle .gitignore
# ---------------------------------------------------------------------

# Gradle
.gradle/
build/
*/build/
captures/

# Local configuration (SDK paths, secrets, API keys) — nunca subir
local.properties
*.local.properties

# Android build artifacts
*.apk
*.aab
*.ap_
*.aar
*.dex
*.class
bin/
gen/
out/
release/

# Native build
.externalNativeBuild/
.cxx/

# Logs / reports
*.log
lint/
lint-results*.html
lint-results*.xml

# Keystore / signing (¡no subir credenciales!)
*.jks
*.keystore
keystore.properties

# ---------------------------------------------------------------------
# Android Studio / IntelliJ
# ---------------------------------------------------------------------
*.iml
.idea/caches/
.idea/libraries/
.idea/modules.xml
.idea/workspace.xml
.idea/navEditor.xml
.idea/assetWizardSettings.xml
.idea/deploymentTargetDropDown.xml
.idea/deploymentTargetSelector.xml
.idea/gradle.xml
.idea/misc.xml
.idea/*.iml

# ---------------------------------------------------------------------
# Claude Code
# ---------------------------------------------------------------------
.claude/
.agents/
skills-lock.json
claude.md

